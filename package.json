{
  "name": "traceorb-node",
  "version": "0.3.0",
  "description": "Traceorb ingest SDK for Node.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "prepublishOnly": "npm run build",
    "smoke": "npm run build && node scripts/smoke-ingest.mjs"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.1.0",
    "fastify": "^5.12.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
